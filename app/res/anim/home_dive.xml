<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen as an app opens: it fades out while pushing in a little, as if diving into the app. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha
        android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="340"
        android:interpolator="@android:interpolator/accelerate_decelerate" />
    <scale
        android:fromXScale="1.0" android:fromYScale="1.0" android:toXScale="1.07" android:toYScale="1.07"
        android:pivotX="50%" android:pivotY="50%" android:duration="380"
        android:interpolator="@android:interpolator/decelerate_quad" />
</set>
