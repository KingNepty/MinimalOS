<?xml version="1.0" encoding="utf-8"?>
<!-- An app (or a settings screen) opening from the home screen: it fades in while settling up from slightly smaller. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha
        android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="380"
        android:interpolator="@android:interpolator/decelerate_quad" />
    <scale
        android:fromXScale="0.94" android:fromYScale="0.94" android:toXScale="1.0" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="440"
        android:interpolator="@android:interpolator/decelerate_cubic" />
</set>
