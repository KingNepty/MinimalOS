<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black behind everything: opening the home screen (and the MinimalOS splash) never flashes another color. -->
    <color name="home_background">#000000</color>

    <style name="FreeMyTV.Home" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/home_background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowAnimationStyle">@style/FreeMyTV.WindowAnimation</item>
    </style>

    <!-- Coming back to the home screen (from an app, with Back or Home) is a soft fade and settle, not a cut. -->
    <style name="FreeMyTV.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/home_enter</item>
        <item name="android:activityCloseEnterAnimation">@anim/home_enter</item>
        <item name="android:taskOpenEnterAnimation">@anim/home_enter</item>
        <item name="android:taskCloseEnterAnimation">@anim/home_enter</item>
        <item name="android:taskToFrontEnterAnimation">@anim/home_enter</item>
        <item name="android:taskToBackExitAnimation">@anim/home_exit</item>
        <item name="android:taskOpenExitAnimation">@anim/home_exit</item>
        <item name="android:activityOpenExitAnimation">@anim/home_exit</item>
    </style>
</resources>
